# 复制成 .env 后填写；.env 绝对不要提交到 git，也不要发给任何人。
# 小程序后台 → 开发管理 → 开发设置 → 开发者ID 可以拿到 AppID / AppSecret。

# ---------- 微信登录 ----------
# 留空 = 本地调试登录（只在 DJANGO_DEBUG=1 时自动开启，所有调试端共用一个账号）
WX_APPID=
WX_SECRET=
# 生产环境必须关闭调试登录；仅本地联调时可设 1
WX_MOCK_LOGIN=1
WX_DEV_OPENID=dev_openid_0001

# ---------- Django ----------
DJANGO_SECRET_KEY=please-change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# ---------- 数据库（生产用 MySQL） ----------
# 云托管 MySQL：生产必填；本地联调也推荐直接连 MySQL
# MYSQL_HOST=
# MYSQL_PORT=3306
# MYSQL_DATABASE=bupashuiguozhan
# MYSQL_USER=root
# MYSQL_PASSWORD=
#
# 本地调试：没有 MYSQL_HOST 时默认用 server/db.sqlite3
# 生产（DJANGO_DEBUG=0）不允许落容器临时盘；确实要挂 CFS 持久化时再显式设置：
# SQLITE_DIR=/app/data

# ---------- 业务参数 ----------
# 登录态有效期（天）
TOKEN_TTL_DAYS=30
# 同一地址多少秒内只提醒一次（过滤 GPS 抖动）
TRIGGER_COOLDOWN_S=60
